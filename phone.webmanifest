      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "phone-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "id": "unify-flip-phone"
}